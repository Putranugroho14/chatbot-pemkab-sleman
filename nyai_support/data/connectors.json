    "method": "POST",
    "auth_type": "Bearer Token",
    "auth_token": "sk-tour-sleman-live-2026",
    "param_mapping": [
      { "api_param": "destination", "convo_var": "{destinasi_wisata}" },
      { "api_param": "pax", "convo_var": "{jumlah_peserta}" },
      { "api_param": "visit_date", "convo_var": "{tgl_kunjungan}" },
      { "api_param": "contact", "convo_var": "{kontak_wisatawan}" }
    ],
    "response_mapping": [
      { "response_path": "$.data.booking_ref", "variable_name": "booking_ref" },
      { "response_path": "$.data.total_amount", "variable_name": "total_biaya" }
    ],
    "mock_response": {
      "status": "success",
      "data": {
        "booking_ref": "TOUR-SLM-4192",
        "total_biaya": "Rp 350.000 (estimasi)"
      }
    }
  },
  {
    "id": "conn-ticket-system",
