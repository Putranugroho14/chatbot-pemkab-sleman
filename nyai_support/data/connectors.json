    "url": "https://lapor.slemankab.go.id/api/tickets",
    "method": "POST",
    "auth_type": "API Key",
    "auth_token": "apikey-laporsleman-production",
    "param_mapping": [
      { "api_param": "category", "convo_var": "{kategori_aduan}" },
      { "api_param": "detail", "convo_var": "{uraian_aduan}" },
      { "api_param": "phone", "convo_var": "{wa_pelapor}" }
    ],
    "response_mapping": [
      { "response_path": "$.ticket.id", "variable_name": "ticket_id" },
      { "response_path": "$.ticket.priority", "variable_name": "prioritas" }
