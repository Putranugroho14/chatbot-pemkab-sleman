[
  {
    "id": "conn-dukcapil-queue",
    "name": "Sistem Antrean & Verifikasi Dukcapil",
    "url": "https://api.dukcapil.slemankab.go.id/v1/antrean/create",
    "method": "POST",
    "auth_type": "Bearer Token",
    "auth_token": "sk-sleman-dukcapil-demo-key",
    "param_mapping": [
      { "api_param": "nama", "convo_var": "{nama_pemohon}" },
      { "api_param": "nik", "convo_var": "{nik_pemohon}" },
      { "api_param": "phone", "convo_var": "{no_whatsapp}" },
      { "api_param": "layanan", "convo_var": "{layanan_dipilih}" }
    ],
    "response_mapping": [
      { "response_path": "$.data.ticket_code", "variable_name": "ticket_code" },
      { "response_path": "$.data.estimated_time", "variable_name": "estimasi_waktu" }
    ],
    "mock_response": {
      "status": "success",
      "data": {
        "ticket_code": "DKP-2026-8819",
        "estimated_time": "Besok, 09.30 WIB di MPP Sleman"
      }
    }
  },
  {
    "id": "conn-wisata-booking",
